{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProjectTask": {
      "properties": {
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "evaluation": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProjectTaskEvaluation"
            },
            {
              "type": "null"
            }
          ]
        },
        "executionTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "executor": {
          "$ref": "#/definitions/ProjectTaskExecutor"
        },
        "objective": {
          "type": "string"
        },
        "parentTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "requirements": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProjectTaskResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/ProjectTaskStatus"
        },
        "taskId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "createdAt",
        "executor",
        "objective",
        "requirements",
        "status",
        "taskId",
        "title",
        "updatedAt"
      ],
      "type": "object"
    },
    "ProjectTaskEvaluation": {
      "properties": {
        "evaluatedAt": {
          "format": "int64",
          "type": "integer"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        },
        "verdict": {
          "$ref": "#/definitions/ProjectTaskEvaluationVerdict"
        }
      },
      "required": [
        "evaluatedAt",
        "evidence",
        "summary",
        "verdict"
      ],
      "type": "object"
    },
    "ProjectTaskEvaluationVerdict": {
      "enum": [
        "passed",
        "needsRevision",
        "failed"
      ],
      "type": "string"
    },
    "ProjectTaskExecutor": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "unassigned"
              ],
              "title": "UnassignedProjectTaskExecutorType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "UnassignedProjectTaskExecutor",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "mainAgent"
              ],
              "title": "MainAgentProjectTaskExecutorType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "MainAgentProjectTaskExecutor",
          "type": "object"
        },
        {
          "properties": {
            "agentId": {
              "type": "string"
            },
            "type": {
              "enum": [
                "projectAgent"
              ],
              "title": "ProjectAgentProjectTaskExecutorType",
              "type": "string"
            }
          },
          "required": [
            "agentId",
            "type"
          ],
          "title": "ProjectAgentProjectTaskExecutor",
          "type": "object"
        }
      ]
    },
    "ProjectTaskResult": {
      "properties": {
        "artifacts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "completedAt": {
          "format": "int64",
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/definitions/ProjectTaskResultStatus"
        },
        "suggestedChildren": {
          "items": {
            "$ref": "#/definitions/ProjectTaskSuggestedChild"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "artifacts",
        "completedAt",
        "evidence",
        "status",
        "suggestedChildren",
        "summary"
      ],
      "type": "object"
    },
    "ProjectTaskResultStatus": {
      "enum": [
        "completed",
        "rejected",
        "blockedMissingTool",
        "failed"
      ],
      "type": "string"
    },
    "ProjectTaskStatus": {
      "enum": [
        "pending",
        "inProgress",
        "completed",
        "rejected",
        "blocked",
        "failed"
      ],
      "type": "string"
    },
    "ProjectTaskSuggestedChild": {
      "properties": {
        "objective": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "objective",
        "title"
      ],
      "type": "object"
    }
  },
  "properties": {
    "executionTaskId": {
      "type": "string"
    },
    "task": {
      "$ref": "#/definitions/ProjectTask"
    }
  },
  "required": [
    "executionTaskId",
    "task"
  ],
  "title": "ThreadProjectTaskExecutionStartResponse",
  "type": "object"
}
