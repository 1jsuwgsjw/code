{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProjectAgentRosterEntry": {
      "properties": {
        "activeSessionThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentTask": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProjectAgentTask"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProjectAgentSession"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "description",
        "enabled",
        "id"
      ],
      "type": "object"
    },
    "ProjectAgentSession": {
      "properties": {
        "agentId": {
          "type": "string"
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "threadId": {
          "type": "string"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "agentId",
        "createdAt",
        "generation",
        "threadId",
        "updatedAt"
      ],
      "type": "object"
    },
    "ProjectAgentTask": {
      "properties": {
        "agentId": {
          "type": "string"
        },
        "attempt": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "parentThreadId": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/definitions/ProjectAgentTaskPhase"
        },
        "sessionThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "agentId",
        "attempt",
        "createdAt",
        "parentThreadId",
        "phase",
        "task",
        "taskId",
        "updatedAt"
      ],
      "type": "object"
    },
    "ProjectAgentTaskPhase": {
      "enum": [
        "queued",
        "running",
        "completed",
        "interrupted",
        "failed"
      ],
      "type": "string"
    }
  },
  "properties": {
    "data": {
      "items": {
        "$ref": "#/definitions/ProjectAgentRosterEntry"
      },
      "type": "array"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "projectRoot": {
      "type": "string"
    },
    "total": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "data",
    "projectRoot",
    "total"
  ],
  "title": "ThreadProjectAgentListResponse",
  "type": "object"
}