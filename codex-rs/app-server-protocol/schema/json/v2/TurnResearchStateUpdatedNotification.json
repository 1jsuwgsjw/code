{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TurnResearchEntryKind": {
      "enum": [
        "fact",
        "constraint",
        "goal",
        "unknown",
        "hypothesis",
        "exploration",
        "decision",
        "futurePressure",
        "outcome"
      ],
      "type": "string"
    },
    "TurnResearchScope": {
      "enum": [
        "task",
        "project"
      ],
      "type": "string"
    },
    "TurnResearchStateEntry": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/TurnResearchEntryKind"
        },
        "scope": {
          "$ref": "#/definitions/TurnResearchScope"
        },
        "statement": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/TurnResearchStatus"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
        "kind",
        "subject",
        "statement",
        "status"
      ],
      "type": "object"
    },
    "TurnResearchStatus": {
      "enum": [
        "open",
        "supported",
        "rejected",
        "resolved",
        "superseded"
      ],
      "type": "string"
    }
  },
  "properties": {
    "changed": {
      "type": "boolean"
    },
    "entries": {
      "items": {
        "$ref": "#/definitions/TurnResearchStateEntry"
      },
      "type": "array"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "turnId",
    "revision",
    "changed",
    "entries"
  ],
  "title": "TurnResearchStateUpdatedNotification",
  "type": "object"
}
