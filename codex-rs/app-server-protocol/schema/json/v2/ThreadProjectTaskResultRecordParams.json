{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProjectTaskResult": {
      "properties": {
        "artifacts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "completedAt": {
          "format": "int64",
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/definitions/ProjectTaskResultStatus"
        },
        "suggestedChildren": {
          "items": {
            "$ref": "#/definitions/ProjectTaskSuggestedChild"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "artifacts",
        "completedAt",
        "evidence",
        "status",
        "suggestedChildren",
        "summary"
      ],
      "type": "object"
    },
    "ProjectTaskResultStatus": {
      "enum": [
        "completed",
        "rejected",
        "blockedMissingTool",
        "failed"
      ],
      "type": "string"
    },
    "ProjectTaskSuggestedChild": {
      "properties": {
        "objective": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "objective",
        "title"
      ],
      "type": "object"
    }
  },
  "properties": {
    "result": {
      "$ref": "#/definitions/ProjectTaskResult"
    },
    "taskId": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "result",
    "taskId",
    "threadId"
  ],
  "title": "ThreadProjectTaskResultRecordParams",
  "type": "object"
}