{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ContextCheckpointDetails": {
      "properties": {
        "checkpointRef": {
          "type": "string"
        },
        "firstWindowId": {
          "type": "string"
        },
        "generationId": {
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "previousWindowId": {
          "type": [
            "string",
            "null"
          ]
        },
        "stateEntryCount": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "turnRecordId": {
          "type": "string"
        },
        "windowId": {
          "type": "string"
        },
        "windowNumber": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "checkpointRef",
        "firstWindowId",
        "generationId",
        "labels",
        "stateEntryCount",
        "turnRecordId",
        "windowId",
        "windowNumber"
      ],
      "type": "object"
    }
  },
  "description": "Deprecated: Use `ContextCompaction` item type instead.",
  "properties": {
    "checkpoint": {
      "anyOf": [
        {
          "$ref": "#/definitions/ContextCheckpointDetails"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "turnId"
  ],
  "title": "ContextCompactedNotification",
  "type": "object"
}