{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProjectAgentTask": {
      "properties": {
        "agentId": {
          "type": "string"
        },
        "attempt": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "parentThreadId": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/definitions/ProjectAgentTaskPhase"
        },
        "sessionThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "agentId",
        "attempt",
        "createdAt",
        "parentThreadId",
        "phase",
        "task",
        "taskId",
        "updatedAt"
      ],
      "type": "object"
    },
    "ProjectAgentTaskPhase": {
      "enum": [
        "queued",
        "running",
        "completed",
        "interrupted",
        "failed"
      ],
      "type": "string"
    }
  },
  "properties": {
    "task": {
      "$ref": "#/definitions/ProjectAgentTask"
    }
  },
  "required": [
    "task"
  ],
  "title": "ThreadProjectAgentRetryResponse",
  "type": "object"
}