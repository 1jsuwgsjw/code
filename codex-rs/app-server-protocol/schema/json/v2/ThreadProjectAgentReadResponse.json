{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProjectAgentDefinition": {
      "properties": {
        "constraintsFile": {
          "type": "string"
        },
        "definitionPath": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "memoryMaxItems": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "memoryMaxTokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelProvider": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelReasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "constraintsFile",
        "definitionPath",
        "description",
        "enabled",
        "id",
        "memoryMaxItems",
        "memoryMaxTokens",
        "tools"
      ],
      "type": "object"
    },
    "ProjectAgentPersistedResult": {
      "properties": {
        "agentId": {
          "type": "string"
        },
        "artifacts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "improvementProposals": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "memoryCandidates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "result": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ProjectAgentTaskStatus"
        },
        "taskId": {
          "type": "string"
        }
      },
      "required": [
        "agentId",
        "artifacts",
        "evidence",
        "improvementProposals",
        "memoryCandidates",
        "result",
        "status",
        "taskId"
      ],
      "type": "object"
    },
    "ProjectAgentSession": {
      "properties": {
        "agentId": {
          "type": "string"
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "threadId": {
          "type": "string"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "agentId",
        "createdAt",
        "generation",
        "threadId",
        "updatedAt"
      ],
      "type": "object"
    },
    "ProjectAgentTask": {
      "properties": {
        "agentId": {
          "type": "string"
        },
        "attempt": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "parentThreadId": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/definitions/ProjectAgentTaskPhase"
        },
        "sessionThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "agentId",
        "attempt",
        "createdAt",
        "parentThreadId",
        "phase",
        "task",
        "taskId",
        "updatedAt"
      ],
      "type": "object"
    },
    "ProjectAgentTaskPhase": {
      "enum": [
        "queued",
        "running",
        "completed",
        "interrupted",
        "failed"
      ],
      "type": "string"
    },
    "ProjectAgentTaskStatus": {
      "enum": [
        "completed",
        "rejectedOutOfScope",
        "blockedMissingTool",
        "failed"
      ],
      "type": "string"
    }
  },
  "properties": {
    "activeSessionThreadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent": {
      "$ref": "#/definitions/ProjectAgentDefinition"
    },
    "currentResult": {
      "anyOf": [
        {
          "$ref": "#/definitions/ProjectAgentPersistedResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "currentTask": {
      "anyOf": [
        {
          "$ref": "#/definitions/ProjectAgentTask"
        },
        {
          "type": "null"
        }
      ]
    },
    "projectRoot": {
      "type": "string"
    },
    "recentResults": {
      "items": {
        "$ref": "#/definitions/ProjectAgentPersistedResult"
      },
      "type": "array"
    },
    "recentTasks": {
      "items": {
        "$ref": "#/definitions/ProjectAgentTask"
      },
      "type": "array"
    },
    "session": {
      "anyOf": [
        {
          "$ref": "#/definitions/ProjectAgentSession"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "agent",
    "projectRoot",
    "recentResults",
    "recentTasks"
  ],
  "title": "ThreadProjectAgentReadResponse",
  "type": "object"
}